{
  "ConnectionStrings": {
    "Default": "",
    "Sqlite": "Data Source=app.db"
  },
  "Clinic": {
    "TimeZoneId": "Central Standard Time"
  },
  "Seed": {
    "Enabled": true,
    "DemoActivity": true
  },
  "Jwt": {
    "Issuer": "ClinicQ",
    "Audience": "ClinicQ.Api",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "no-reply@clinicq.example",
    "FromName": "ClinicQ"
  },
  "Storage": {
    "AzureBlobConnectionString": "",
    "ContainerName": "lab-reports",
    "LocalRootPath": "storage",
    "DownloadLinkMinutes": 15,
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [ "application/pdf", "image/png", "image/jpeg" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
