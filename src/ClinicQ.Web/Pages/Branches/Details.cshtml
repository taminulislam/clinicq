@page "{id:int}"
@model ClinicQ.Web.Pages.Branches.DetailsModel
@{
    ViewData["Title"] = Model.Branch.Name;
    var disabled = !Model.IsAdmin;
    var current = Model.Fees.GroupBy(f => f.ServiceCode).Select(g => g.OrderByDescending(f => f.EffectiveFrom).First()).OrderBy(f => f.ServiceCode).ToList();
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Branch.Name</h1>
        <div class="text-muted">@Model.Branch.AddressLine, @Model.Branch.City @Model.Branch.State &middot; tax @Model.Branch.TaxRatePercent.ToString("0.##")%</div>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">All branches</a>
</div>

@if (!Model.IsAdmin)
{
    <div class="alert alert-info py-2">Read-only: only administrators can change slot rules and fees.</div>
}

<div class="row g-3">
    <div class="col-lg-5">
        <form method="post" asp-page-handler="Rule" asp-route-id="@Model.Branch.Id" class="card">
            <div class="card-header bg-white fw-semibold">Slot rules</div>
            <div class="card-body">
                <fieldset disabled="@disabled">
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label small mb-0" for="rule-open">Opens</label><input id="rule-open" name="OpenTime" type="time" class="form-control" value="@Model.Rule.OpenTime" /></div>
                        <div class="col-6"><label class="form-label small mb-0" for="rule-close">Closes</label><input id="rule-close" name="CloseTime" type="time" class="form-control" value="@Model.Rule.CloseTime" /></div>
                        <div class="col-6"><label class="form-label small mb-0" for="rule-duration">Slot length (min)</label><input id="rule-duration" name="SlotDurationMinutes" type="number" min="5" max="240" class="form-control" value="@Model.Rule.SlotDurationMinutes" /></div>
                        <div class="col-6"><label class="form-label small mb-0" for="rule-max">Bookings per slot</label><input id="rule-max" name="MaxBookingsPerSlot" type="number" min="1" max="10" class="form-control" value="@Model.Rule.MaxBookingsPerSlot" /></div>
                        <div class="col-6"><label class="form-label small mb-0" for="rule-lead">Min lead time (h)</label><input id="rule-lead" name="MinLeadTimeHours" type="number" min="0" max="168" class="form-control" value="@Model.Rule.MinLeadTimeHours" /></div>
                        <div class="col-6"><label class="form-label small mb-0" for="rule-advance">Book ahead (days)</label><input id="rule-advance" name="MaxAdvanceDays" type="number" min="1" max="365" class="form-control" value="@Model.Rule.MaxAdvanceDays" /></div>
                        <div class="col-12">
                            <span class="form-label small d-block mb-1">Working days</span>
                            @foreach (var (day, flag) in ClinicQ.Web.Pages.Branches.DetailsModel.Days)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="days" value="@flag" id="day-@flag" checked="@((Model.Rule.WorkingDaysMask & flag) != 0)" />
                                    <label class="form-check-label" for="day-@flag">@day.ToString()[..3]</label>
                                </div>
                            }
                        </div>
                    </div>
                </fieldset>
            </div>
            @if (Model.IsAdmin)
            {
                <div class="card-footer bg-white"><button type="submit" class="btn btn-primary">Save slot rules</button></div>
            }
        </form>

        <div class="card mt-3">
            <div class="card-header bg-white fw-semibold">Doctors</div>
            <ul class="list-group list-group-flush">
                @foreach (var d in Model.Doctors)
                {
                    <li class="list-group-item">@d.FullName <span class="text-muted small">- @d.Specialty</span></li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Fee schedule (current prices)</div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead><tr><th>Code</th><th>Service</th><th class="text-end">Fee</th><th>Effective</th></tr></thead>
                    <tbody>
                        @foreach (var f in current)
                        {
                            <tr><td>@f.ServiceCode</td><td>@f.Description</td><td class="text-end">@f.Amount.ToString("C2")</td><td>@f.EffectiveFrom.ToString("d MMM yyyy")</td></tr>
                        }
                    </tbody>
                </table>
                @if (Model.IsAdmin)
                {
                    <form method="post" asp-page-handler="Fee" asp-route-id="@Model.Branch.Id" class="row g-2 align-items-end">
                        <div class="col-md-3"><label class="form-label small mb-0" for="fee-code">Code</label><input id="fee-code" name="ServiceCode" class="form-control form-control-sm" required maxlength="30" /></div>
                        <div class="col-md-5"><label class="form-label small mb-0" for="fee-desc">Description</label><input id="fee-desc" name="Description" class="form-control form-control-sm" required maxlength="200" /></div>
                        <div class="col-md-2"><label class="form-label small mb-0" for="fee-amount">Fee</label><input id="fee-amount" name="Amount" type="number" step="0.01" min="0" class="form-control form-control-sm" required /></div>
                        <div class="col-md-2 d-grid"><button type="submit" class="btn btn-sm btn-primary">Add / reprice</button></div>
                    </form>
                    <p class="small text-muted mt-2 mb-0">Adding an existing code creates a new effective-dated price; invoices always use the latest active price.</p>
                }
            </div>
        </div>
    </div>
</div>
