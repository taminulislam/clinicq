@page "{id:int}"
@model ClinicQ.Web.Pages.Appointments.EditModel
@{
    ViewData["Title"] = $"Edit appointment #{Model.Appointment.Id}";
}

<h1 class="h3 mb-1">Edit appointment #@Model.Appointment.Id</h1>
<p class="text-muted">@Model.Appointment.ScheduledStart.ToString("dddd d MMMM yyyy, HH:mm") <span class="badge @Badges.For(Model.Appointment.Status)">@Badges.Label(Model.Appointment.Status)</span></p>

<form method="post" class="card" style="max-width: 48rem;">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="mb-3">
            <label asp-for="Input.Reason" class="form-label">Reason for visit</label>
            <input asp-for="Input.Reason" class="form-control" />
            <span asp-validation-for="Input.Reason"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Notes" class="form-label">Notes</label>
            <textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Input.Notes"></span>
        </div>
        <p class="small text-muted mb-0">To change the time, cancel this appointment and book a new slot so capacity rules are re-checked.</p>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="Details" asp-route-id="@Model.Appointment.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
