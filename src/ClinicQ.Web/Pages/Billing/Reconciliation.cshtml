@page
@model ClinicQ.Web.Pages.Billing.ReconciliationModel
@{
    ViewData["Title"] = "Billing reconciliation";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Billing reconciliation</h1>
        <div class="text-muted small">Runs nightly at 02:00 via Hangfire (<code>usp_ReconcileBilling</code> on SQL Server).</div>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="Run" class="d-flex gap-2">
            <input asp-for="Day" type="date" class="form-control" value="@Model.Day.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary text-nowrap">Reconcile day</button>
        </form>
        <form method="post" asp-page-handler="Enqueue">
            <button type="submit" class="btn btn-outline-secondary text-nowrap">Queue nightly job</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover js-datatable" data-order='[[0,"desc"]]'>
            <thead>
                <tr><th>Run at</th><th>Branch</th><th>Period</th><th class="text-end">Invoices</th><th class="text-end">Invoiced</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th><th class="text-end">Unbilled visits</th><th>Notes</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Runs)
                {
                    <tr class="@(r.UnbilledCompletedAppointments > 0 ? "table-warning" : "")">
                        <td data-order="@r.RunAt.ToString("s")">@r.RunAt.ToString("d MMM yyyy HH:mm")</td>
                        <td>@Model.BranchNames.GetValueOrDefault(r.BranchId, $"#{r.BranchId}")</td>
                        <td>@r.PeriodStart.ToString("d MMM") - @r.PeriodEnd.AddSeconds(-1).ToString("d MMM yyyy")</td>
                        <td class="text-end">@r.InvoiceCount</td>
                        <td class="text-end">@r.TotalInvoiced.ToString("C2")</td>
                        <td class="text-end">@r.TotalPaid.ToString("C2")</td>
                        <td class="text-end">@r.Outstanding.ToString("C2")</td>
                        <td class="text-end">@r.UnbilledCompletedAppointments</td>
                        <td class="small">@r.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
