@page "{id:int}"
@model ClinicQ.Web.Pages.Patients.DetailsModel
@{
    var p = Model.Patient;
    ViewData["Title"] = p.FullName;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@p.FullName</h1>
        <div class="text-muted">@p.Mrn &middot; @p.Gender &middot; @Model.Age years (born @p.DateOfBirth.ToString("d MMM yyyy"))</div>
        @if (!string.IsNullOrWhiteSpace(p.Allergies))
        {
            <span class="badge text-bg-danger mt-1"><i class="bi bi-exclamation-triangle"></i> Allergies: @p.Allergies</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Appointments/Create" asp-route-patientId="@p.Id" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Book</a>
        <a asp-page="/LabReports/Upload" asp-route-patientId="@p.Id" class="btn btn-outline-primary"><i class="bi bi-upload"></i> Lab report</a>
        <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold">Contact</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Phone</dt><dd>@p.Phone</dd>
                    <dt>Email</dt><dd>@p.Email</dd>
                    <dt>Address</dt><dd class="mb-0">@p.AddressLine<br />@p.City @p.State @p.PostalCode</dd>
                </dl>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold">Account</div>
            <div class="card-body">
                <div class="kpi-label">Outstanding balance</div>
                <div class="kpi-value @(Model.OutstandingBalance > 0 ? "text-danger" : "text-success")">@Model.OutstandingBalance.ToString("C2")</div>
                <ul class="list-unstyled small mt-2 mb-0">
                    @foreach (var i in Model.Invoices.Take(8))
                    {
                        <li><a asp-page="/Invoices/Details" asp-route-id="@i.Id">@i.InvoiceNumber</a> <span class="badge @Badges.For(i.Status)">@Badges.Label(i.Status)</span> <span class="float-end">@i.Total.ToString("C2")</span></li>
                    }
                </ul>
            </div>
        </div>
        <div class="card">
            <div class="card-header bg-white fw-semibold">Lab reports</div>
            <ul class="list-group list-group-flush small">
                @foreach (var r in Model.LabReports)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@r.TestName<br /><span class="text-muted">@r.UploadedAt.ToString("d MMM yyyy")</span></span>
                        <a asp-page="/LabReports/Index" asp-page-handler="Download" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Download</a>
                    </li>
                }
                @if (Model.LabReports.Count == 0)
                {
                    <li class="list-group-item text-muted">None on file.</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold">Visits</div>
            <div class="card-body">
                <table class="table table-sm table-hover js-datatable" data-order='[[0,"desc"]]' data-page-length="10">
                    <thead>
                        <tr><th>When</th><th>Doctor</th><th>Branch</th><th>Reason</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Appointments)
                        {
                            <tr>
                                <td data-order="@a.ScheduledStart.ToString("s")"><a asp-page="/Appointments/Details" asp-route-id="@a.Id">@a.ScheduledStart.ToString("d MMM yyyy HH:mm")</a></td>
                                <td>@a.DoctorName</td>
                                <td>@a.BranchName</td>
                                <td>@a.Reason</td>
                                <td><span class="badge @Badges.For(a.Status)">@Badges.Label(a.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header bg-white fw-semibold">Prescriptions</div>
            <ul class="list-group list-group-flush">
                @foreach (var rx in Model.Prescriptions)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@rx.IssuedAt.ToString("d MMM yyyy")</strong> - @string.Join(", ", rx.Items.Select(i => $"{i.Medication} {i.Dosage} {i.Frequency}"))</span>
                        <span class="text-nowrap">
                            <a asp-page="/Prescriptions/Details" asp-route-id="@rx.Id" class="btn btn-sm btn-outline-secondary">Open</a>
                            <a asp-page="/Prescriptions/Details" asp-route-id="@rx.Id" asp-page-handler="Pdf" class="btn btn-sm btn-outline-secondary">PDF</a>
                        </span>
                    </li>
                }
                @if (Model.Prescriptions.Count == 0)
                {
                    <li class="list-group-item text-muted">No prescriptions issued.</li>
                }
            </ul>
        </div>
    </div>
</div>
